# =====================================================================
# SpendSense — India-First Personal Finance Platform Environment Config
# =====================================================================

# Application Environment ('development' or 'production')
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY_CODE=+91
DEFAULT_TIMEZONE=Asia/Kolkata

# Session & Security Settings
# In production, generate a secure 64-character random key: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_with_a_cryptographically_secure_random_key_64_characters
SESSION_COOKIE_NAME=spendsense_session
SESSION_MAX_AGE_SECONDS=604800

# Security TTLs (in minutes)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
OTP_TTL_MINUTES=10

# Database Backups Retention
MAX_BACKUP_RETENTION=10

# =====================================================================
# SMS Authentication (Twilio Verify v2)
# =====================================================================
# For production SMS in India:
# 1. Register on Telecom Commercial Communications Customer Preference Portal (DLT) in India
# 2. Complete Enterprise Registration, obtain Principal Entity ID (PE ID) & Header/Sender ID
# 3. Create a Twilio Verify Service in Twilio Console (SID starts with 'VA...')
# 4. Bind Approved DLT Template ID to your Twilio Verify Service
#
# Provider modes:
# - 'console': Local dev mode. OTP codes are logged directly to the server terminal.
# - 'twilio': Production mode. Dispatches real SMS using Twilio Verify v2 REST API.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# =====================================================================
# Transactional Email Delivery (Resend)
# =====================================================================
# For production email delivery in India:
# 1. Sign up at https://resend.com
# 2. Add and verify your custom sending domain with SPF and DKIM DNS records
# 3. Generate an API Key with Sending access
#
# Provider modes:
# - 'console': Local dev mode. Verification & password reset links are logged to terminal.
# - 'resend': Production mode. Dispatches verified emails via Resend HTTPS API.
EMAIL_PROVIDER=console
EMAIL_FROM=SpendSense <noreply@yourdomain.com>
RESEND_API_KEY=

# Optional SMTP Configuration (if using standard SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
